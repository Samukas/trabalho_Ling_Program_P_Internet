# Modelo legado: o .env recomendado agora fica na RAIZ do projeto
# (copie .env.example da raiz para .env la). Este caminho em src/php/.env
# continua funcionando como fallback (config.php le os dois).
#
#   Linux/Mac:  cp ../../.env.example ../../.env
#   Windows:    copy ..\..\.env.example ..\..\.env
#
# nunca commite o .env: ele ja esta no .gitignore.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=biblioteca
DB_USER=postgres
DB_PASS=troque-pela-senha-do-banco-local

# Usuario do painel administrativo
ADMIN_USER=admin
# Gere um hash novo para a sua senha (nunca use o hash de exemplo):
#   php -r "echo password_hash('sua-senha', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASS_HASH=cole-aqui-o-hash-gerado

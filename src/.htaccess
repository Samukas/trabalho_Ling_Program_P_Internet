# Vazio de proposito: com AllowOverride restrito, qualquer diretiva em
# .htaccess gera erro 500. A protecao padrao nao depende daqui — o .env fica
# na raiz do projeto (fora deste DocumentRoot) e o router.php bloqueia os
# arquivos sensiveis no php -S.
#
# Se o Apache tiver "AllowOverride All", da para descomentar abaixo para
# negar acesso direto a arquivos sensiveis por aqui.

# <FilesMatch "^\.env">
#     Require all denied
# </FilesMatch>
#
# <FilesMatch "\.(log|sql|bak|ini)$">
#     Require all denied
# </FilesMatch>
#
# Com o mod_headers ligado (sudo a2enmod headers), descomente para mandar os
# headers de seguranca tambem nos estaticos (hoje vao via PHP em
# php/seguranca.php e via meta CSP no HTML):
#
# Header always set X-Content-Type-Options "nosniff"
# Header always set X-Frame-Options "DENY"
# Header always set Referrer-Policy "strict-origin-when-cross-origin"
# Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"

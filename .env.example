# Copie este arquivo para .env nesta pasta (raiz do projeto, fora do
# DocumentRoot src/) e preencha os valores reais.
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env
# nunca commite o .env: ele ja esta no .gitignore.
#
# O .env tambem pode ficar em src/php/.env (caminho antigo, funciona como
# fallback), mas a raiz do projeto e o lugar recomendado porque fica fora
# da pasta servida pelo Apache/php -S.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=biblioteca
DB_USER=postgres
DB_PASS=troque-pela-senha-do-banco-local

# Usuario do painel administrativo
ADMIN_USER=admin
# Gere um hash novo para a sua senha (nunca use o hash de exemplo):
#   php -r "echo password_hash('sua-senha', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASS_HASH=cole-aqui-o-hash-gerado
